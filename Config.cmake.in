@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/kappa++Targets.cmake")
set_and_check(KAPPA_RESOURCES_FILES_DIR "${PACKAGE_PREFIX_DIR}/@RESOURCES_FILES_DIR@")

set(Armadillo_DIR "@Armadillo_DIR@")
set(OpenBLAS_DIR "@OpenBLAS_DIR@")

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Armadillo REQUIRED)
find_dependency(OpenBLASCustom REQUIRED)

check_required_components(kappa++)
